# RUN: llc -mtriple=x86_64-unknown-linux-gnu \
# RUN: --load=%llvmshlibdir/egorova_l_function_inlining_BACKEND%shlibext \
# RUN: -run-pass=egorova-x86-inline %s -o - | FileCheck %s

# CHECK-LABEL: name: recfun
# CHECK: ADD32ri
# CHECK: ADD32ri
# CHECK: ADD32ri
# CHECK: CALL64pcrel32 @recfun
# CHECK: RET64
---
name: recfun
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    CALL64pcrel32 @recfun
    RET64

# CHECK-LABEL: name: caller_big
# CHECK: CALL64pcrel32 @bigfun
# CHECK: RET64
---
name: bigfun
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    %14:gr32 = MOV32ri 14
    %15:gr32 = MOV32ri 15
    RET64

---
name: caller_big
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @bigfun
    RET64

# CHECK-LABEL: name: caller_small
# CHECK: CALL64pcrel32 @smallfun
# CHECK: RET64
---
name: smallfun
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = ADD32ri %0, 5, implicit-def $eflags
    $eax = COPY %1
    RET64

---
name: caller_small
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    CALL64pcrel32 @smallfun
    RET64

# CHECK-LABEL: name: foo1
# CHECK: ADD32ri
# CHECK: RET64
---
name: foo1
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 1
    %1:gr32 = ADD32ri %0, 7, implicit-def $eflags
    RET64

# CHECK-LABEL: name: foo2
# CHECK: CALL64pcrel32 @foo1
# CHECK: SUB32ri
# CHECK: RET64
---
name: foo2
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @foo1
    %2:gr32 = MOV32ri 9
    %3:gr32 = SUB32ri %2, 3, implicit-def $eflags
    RET64

# CHECK-LABEL: name: foo3
# CHECK: CALL64pcrel32 @foo2
# CHECK: XOR32rr
# CHECK: RET64
---
name: foo3
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @foo2
    %4:gr32 = XOR32rr %4, %4, implicit-def $eflags
    RET64

# CHECK-LABEL: name: caller_multi_bb
# CHECK: CALL64pcrel32 @multi_bb_func
# CHECK: RET64
---
name: multi_bb_func
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    CMP32ri %0, 5, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
  bb.1:
    %1:gr32 = MOV32ri 1
    RET64
  bb.2:
    %2:gr32 = MOV32ri 2
    RET64

---
name: caller_multi_bb
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @multi_bb_func
    RET64

