    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    %14:gr32 = MOV32ri 14
